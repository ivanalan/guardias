{
  "expo": {
    "name": "Mi Guardia",
    "slug": "guardias",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "miguardia",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-image",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1EC",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Mi Guardia necesita permiso para agregar tus guardias al Calendario."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Mi Guardia necesita permiso para guardar la imagen del calendario en Fotos.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/instrument-serif/400Regular/InstrumentSerif_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "TwoWeekCalendar",
              "label": "Calendario 2 semanas",
              "description": "Tus guardias de esta semana y la siguiente",
              "minWidth": "400dp",
              "minHeight": "200dp",
              "targetCellWidth": 5,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.alanmatias.guardias",
      "infoPlist": {
        "CFBundleDisplayName": "Mi Guardia",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alanmatias.guardias",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F1EC"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b35ff97f-7787-4876-9632-46e03a263082"
      },
      "expo-status-bar": {
        "style": "dark"
      }
    },
    "owner": "10alanm"
  }
}
