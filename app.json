{
  "expo": {
    "name": "Guardias",
    "slug": "guardias",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-image",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1EC",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "ios": {
      "bundleIdentifier": "com.alanmatias.guardias",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alanmatias.guardias",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F1EC"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b35ff97f-7787-4876-9632-46e03a263082"
      },
      "expo-status-bar": {
        "style": "dark"
      }
    },
    "owner": "10alanm"
  }
}
