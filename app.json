{
  "expo": {
    "name": "guardias",
    "slug": "guardias",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "bundleIdentifier": "com.10alanm.guardias"
    }
  }
}
